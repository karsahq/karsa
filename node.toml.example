# Karsa node configuration.
#
# Generated on first run when the path is missing. Edit it freely: an existing file
# is never overwritten, and a file with problems stops the node before it writes.
#
# Roles compose:
#   validator             signs: authors one vertex per round and votes
#   archive               keeps every vertex and batch forever, does not sign
#   validator + archive   signs and keeps everything
#   rpc                   serves wallets and indexers, independent of the two above
#
# Every validator runs its own copy: retention and roles are local decisions with
# local costs, not chain constants.

[node]
id = "val-0"
data_dir = "/var/lib/karsa"
listen = "0.0.0.0:26656"

[roles]
# A validator signs: it authors one vertex per round and votes in consensus.
# Set false for a node that only stores and serves; it signs nothing.
validator = true
# An archive keeps every vertex and batch forever. It composes with the other
# roles: validator + archive signs and keeps everything, while a pure archive
# (validator = false) never signs.
archive = false

[storage]
# Full payload kept for this many days. A validator only needs enough to serve a
# peer that is behind; history itself is served by archive nodes.
retain_days = 30
# Hard cap. Retention is "this many days OR this much disk, whichever comes first",
# so a traffic spike cannot fill the volume.
max_disk_gb = 500
# Write a state snapshot every this many commits. Pruning never goes below the
# newest snapshot.
snapshot_interval = 10000
# Certified headers are what a light client checks; they are small and kept.
keep_headers = true

[rpc]
# Serve RPC to wallets and indexers. Independent of the two above.
enable = false
rpc_listen = "127.0.0.1:26657"
